# TripTrek Docker environment
# Copy to .env and edit secrets before first run.

# JWT / session secret — generate: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-a-real-secret

# App URL for cookies/redirects (local Docker)
NEXTAUTH_URL=http://localhost:3000

# Optional: Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: AI summaries (OpenAI-compatible). Without key → local draft from trip data.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
