# TripTrek — секреты продакшена (скопировать в .env и заполнить).
# .env не коммитится; пример держим в актуальном состоянии.

# --- Обязательно ---
# openssl rand -hex 32
NEXTAUTH_SECRET=change-me-generate-a-real-secret
# Пароль пользователя БД triptrek: openssl rand -hex 16
POSTGRES_PASSWORD=change-me-too
# Публичный URL приложения (без слэша в конце)
NEXTAUTH_URL=https://your-domain.tld

# --- Caddy (TLS) ---
# Домен с A-записью на этот VPS
DOMAIN=your-domain.tld
# Email для сертификатов Let's Encrypt
ACME_EMAIL=admin@your-domain.tld

# --- Web Push (опционально; без ключей push отключён) ---
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Почта (опционально; без SMTP_HOST письма не отправляются) ---
# Локальный postfix-ретранслятор на хосте VPS: порт 25, без TLS и авторизации
# (compose добавляет host.docker.internal через extra_hosts).
# SMTP_USER/SMTP_PASS нужны только для внешнего SMTP.
#SMTP_HOST=host.docker.internal
#SMTP_PORT=25
#MAIL_FROM=TripTrek <no-reply@your-domain.tld>
#SMTP_USER=
#SMTP_PASS=

# --- WebSocket: точный origin, не * ---
WS_ALLOWED_ORIGINS=https://your-domain.tld

# --- LLM (опционально; есть локальный fallback) ---
# OPENAI_API_KEY=   # общий ключ ИИ; в бете оставлен пустым — каждый подключает свой в профиле (BYOK)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Яндекс.Метрика (опционально; без переменной счётчик не подключается) ---
# Номер счётчика (только цифры). Читается в рантайме — достаточно
# docker compose up -d app, пересборка не нужна.
#NEXT_PUBLIC_YANDEX_METRIKA_ID=

# --- Защита диска от фото (опционально) ---
# PHOTO_LIMIT_PER_TRIP=1500   # максимум фото в одной поездке
# PHOTO_MIN_FREE_MB=1024      # свободнее этого — загрузка фото отклоняется (на диске же лежит база)

# --- Временный редирект «первый визит → лендинг» (опционально) ---
# Гостя без сессии, впервые открывшего /login, один раз ведём на лендинг. Значение:
#   1                                  — просто на /landing;
#   /landing?code=XXXXXXXX&utm_source=tiktok&utm_medium=profile&utm_campaign=bio
#                                      — именно на эту ссылку (код приглашения подставится в регистрацию сам;
#                                        параметры из самой ссылки гостя перекрывают эти).
# Вошедшим, уже видевшим лендинг и заходящим по кнопкам лендинга (?mode=…) не мешает.
# Читается в рантайме: поменять/убрать строку и `docker compose up -d app`, пересборка не нужна.
# LANDING_REDIRECT=1
