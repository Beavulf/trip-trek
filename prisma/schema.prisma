// TripTrek — Prisma schema (PostgreSQL-compatible, works on SQLite)
// Multi-trip architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// === Пользователь (глобальный аккаунт) ===
model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  password   String   // bcrypt hash
  emoji      String   @default("👤")
  color      String   @default("#94a3b8")
  avatarUrl  String?  // фото пользователя (загруженное)
  plan       String   @default("free") // free / premium
  planExpiry DateTime? // для премиума
  createdAt  DateTime @default(now())

  memberships TripMember[]
  photos      Photo[]
  expenses    Expense[]
  journals    JournalEntry[]
  messages    BoardMessage[]
  pushSubs    PushSubscription[]
}

// === Push подписка (Web Push для уведомлений) ===
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// === Поездка ===
model Trip {
  id          String    @id @default(cuid())
  title       String
  destination String    @default("China")
  startDate   DateTime
  endDate     DateTime?
  totalDays   Int       @default(12)
  totalBudget Float     @default(1100)
  currency    String    @default("USD")
  inviteCode  String    @unique @default(cuid())
  coverColor  String    @default("#f97316")
  coverEmoji  String    @default("🌏")
  status      String    @default("planning") // planning / active / completed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members      TripMember[]
  days         Day[]
  places       Place[]
  photos       Photo[]
  expenses     Expense[]
  journals     JournalEntry[]
  messages     BoardMessage[]
  checklist    ChecklistItem[]
  info         InfoItem[]
  phrases      Phrase[]
  foods        FoodItem[]
  budgetPlans  BudgetPlan[]
}

// === Участник поездки (связь User ↔ Trip) ===
model TripMember {
  id          String   @id @default(cuid())
  tripId      String
  userId      String
  role        String   @default("member") // owner / member
  displayName String   // имя в рамках поездки
  emoji       String   @default("👤")
  color       String   @default("#94a3b8")
  budget      Float?   // персональный бюджет
  joinedAt    DateTime @default(now())

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

// === День поездки ===
model Day {
  id          String   @id @default(cuid())
  tripId      String
  dayNumber   Int
  date        DateTime
  city        String
  cityKey     String
  title       String
  summary     String?
  accentColor String?

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  places      Place[]
  photos      Photo[]
  expenses    Expense[]
  journals    JournalEntry[]
}

// === Место ===
model Place {
  id          String   @id @default(cuid())
  tripId      String
  name        String
  description String?
  category    String
  lat         Float
  lng         Float
  dayId       String
  timeOfDay   String?
  status      String   @default("planned")
  budget      Float?
  address     String?
  notes       String?
  rating      Int?
  visitedAt   DateTime?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day         Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  photos      Photo[]
}

// === Фото ===
model Photo {
  id            String   @id @default(cuid())
  tripId        String
  url           String
  thumbUrl      String?
  caption       String?
  placeId       String?
  dayId         String
  userId        String?  // кто загрузил (был participantId)
  lat           Float?
  lng           Float?
  address       String?
  takenAt       DateTime @default(now())
  width         Int?
  height        Int?
  createdAt     DateTime @default(now())

  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place         Place?   @relation(fields: [placeId], references: [id], onDelete: SetNull)
  day           Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// === Трата ===
model Expense {
  id          String   @id @default(cuid())
  tripId      String
  amount      Float
  category    String
  description String
  paidById    String   // userId кто заплатил
  dayId       String?
  splitWith   String   @default("")  // comma-separated userIds (пусто = личная трата)
  excludeSelf Boolean  @default(false) // true = плательщик не участвует в делении
  createdAt   DateTime @default(now())

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy      User     @relation(fields: [paidById], references: [id])
  day         Day?     @relation(fields: [dayId], references: [id], onDelete: SetNull)
}

// === Запись дневника ===
model JournalEntry {
  id            String   @id @default(cuid())
  tripId        String
  dayId         String
  userId        String?  // был participantId
  mood          String?
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day           Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// === Сообщение на доске ===
model BoardMessage {
  id            String   @id @default(cuid())
  tripId        String
  content       String
  userId        String?  // был participantId
  pinned        Boolean  @default(false)
  createdAt     DateTime @default(now())

  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// === Чек-лист ===
model ChecklistItem {
  id        String   @id @default(cuid())
  tripId    String
  text      String
  category  String   @default("preparation")
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// === Справка ===
model InfoItem {
  id        String   @id @default(cuid())
  tripId    String
  type      String
  title     String
  content   String
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// === Фраза разговорника ===
model Phrase {
  id         String   @id @default(cuid())
  tripId     String
  category   String
  ru         String
  cn         String
  pinyin     String
  audio      String?
  favorite   Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// === Блюдо ===
model FoodItem {
  id          String   @id @default(cuid())
  tripId      String
  name        String
  nameCn      String?
  description String
  city        String
  place       String?
  price       String?
  emoji       String?
  imageUrl    String?
  tried       Boolean  @default(false)
  rating      Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// === Плановый бюджет по категории ===
model BudgetPlan {
  id        String   @id @default(cuid())
  tripId    String
  category  String
  amount    Float

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, category])
}
