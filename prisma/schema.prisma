// TripTrek — Prisma schema (PostgreSQL, ADR-0002)
// Multi-trip architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Пользователь (глобальный аккаунт) ===
model User {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String
  password   String // bcrypt hash
  emoji      String    @default("👤")
  color      String    @default("#94a3b8")
  avatarUrl  String? // фото пользователя (загруженное)
  plan       String    @default("free") // free / premium
  planExpiry DateTime? // для премиума
  role       String    @default("user") // user / admin
  // Свой ключ ИИ (BYOK): OpenAI-совместимый. Наружу API отдаёт только замаскированный
  // хвост. Приоритет при вызове: свой ключ → админский (AppSettings) → env OPENAI_API_KEY
  aiApiKey   String?
  createdAt  DateTime  @default(now())

  memberships TripMember[]
  photos      Photo[]
  expenses    Expense[]
  journals    JournalEntry[]
  messages    BoardMessage[]
  pushSubs    PushSubscription[]
  feedback    Feedback[]
}

// === Глобальные настройки приложения (singleton-строка id="app") ===
// Общий ключ ИИ и адрес API, заданные админом в /admin → Настройки; используются,
// если у пользователя нет своего ключа. База и модель — настройка сервера целиком
model AppSettings {
  id        String  @id @default("app")
  aiApiKey  String?
  aiBaseUrl String? // напр. https://api.z.ai/api/paas/v4 или https://openrouter.ai/api/v1
  aiModel   String? // напр. glm-4.6, gpt-4o-mini
}

// === Push подписка (Web Push для уведомлений) ===
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// === Поездка ===
model Trip {
  id          String    @id @default(cuid())
  title       String
  destination String    @default("Unknown")
  startDate   DateTime
  endDate     DateTime?
  totalDays   Int       @default(12)
  totalBudget Float     @default(1100)
  currency    String    @default("USD")
  inviteCode  String    @unique @default(cuid())
  coverColor  String    @default("#f97316")
  coverEmoji  String    @default("🌏")
  status      String    @default("planning") // planning / active / completed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members     TripMember[]
  days        Day[]
  places      Place[]
  photos      Photo[]
  expenses    Expense[]
  journals    JournalEntry[]
  messages    BoardMessage[]
  checklist   ChecklistItem[]
  info        InfoItem[]
  phrases     Phrase[]
  foods       FoodItem[]
  budgetPlans BudgetPlan[]
}

// === Участник поездки (связь User ↔ Trip) ===
model TripMember {
  id          String   @id @default(cuid())
  tripId      String
  userId      String
  role        String   @default("member") // owner / member
  displayName String // имя в рамках поездки
  emoji       String   @default("👤")
  color       String   @default("#94a3b8")
  budget      Float? // персональный бюджет
  joinedAt    DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

// === День поездки ===
model Day {
  id          String   @id @default(cuid())
  tripId      String
  dayNumber   Int
  date        DateTime
  city        String
  cityKey     String
  title       String
  summary     String?
  accentColor String?

  trip     Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  places   Place[]
  photos   Photo[]
  expenses Expense[]
  journals JournalEntry[]

  @@index([tripId])
}

// === Место ===
model Place {
  id          String    @id @default(cuid())
  tripId      String
  name        String
  description String?
  category    String
  lat         Float
  lng         Float
  dayId       String
  timeOfDay   String?
  status      String    @default("planned")
  budget      Float?
  address     String?
  notes       String?
  rating      Int?
  visitedAt   DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  trip   Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day    Day     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@index([tripId])
  @@index([dayId])
}

// === Фото ===
model Photo {
  id         String   @id @default(cuid())
  tripId     String
  url        String
  thumbUrl   String?
  caption    String?
  isFavorite Boolean  @default(false)
  placeId    String?
  dayId      String
  userId     String? // кто загрузил (был participantId)
  lat        Float?
  lng        Float?
  address    String?
  takenAt    DateTime @default(now())
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)
  day   Day    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([dayId])
  @@index([placeId])
}

// === Трата ===
model Expense {
  id               String   @id @default(cuid())
  tripId           String
  amount           Float
  category         String
  description      String
  paidById         String // userId кто заплатил
  dayId            String?
  splitWith        String   @default("") // comma-separated userIds (пусто = личная трата)
  excludeSelf      Boolean  @default(false) // true = плательщик не участвует в делении
  // Исходная сумма и валюта, как пользователь её ввёл (до конвертации в валюту поездки).
  // amount всегда хранится в валюте поездки. originalAmount/originalCurrency хранят то,
  // что ввёл пользователь — чтобы можно было показать «изначально 100 ¥» под конвертированной суммой.
  originalAmount   Float?
  originalCurrency String?
  // settlementKey — детерминированный ключ для идемпотентности переводов (P0 #3).
  // Формат: "settle-{fromId}-{toId}-{сумма-в-центах}-{timestamp}" — уникален на каждый
  // факт перевода, поэтому одна пара может гасить одинаковые по сумме долги многократно.
  settlementKey    String?  @unique
  createdAt        DateTime @default(now())

  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy User @relation(fields: [paidById], references: [id])
  day    Day? @relation(fields: [dayId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([paidById])
}

// === Запись дневника ===
model JournalEntry {
  id        String   @id @default(cuid())
  tripId    String
  dayId     String
  userId    String? // был participantId
  mood      String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day  Day   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([dayId])
}

// === Сообщение в чате ===
model BoardMessage {
  id        String    @id @default(cuid())
  tripId    String
  content   String
  userId    String? // был participantId
  pinned    Boolean   @default(false)
  reactions String? // JSON {"👍":["userId",...]}
  editedAt  DateTime?
  replyToId String?
  createdAt DateTime  @default(now())

  trip    Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  replyTo BoardMessage?  @relation("BoardReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies BoardMessage[] @relation("BoardReply")

  @@index([tripId])
}

// === Чек-лист ===
model ChecklistItem {
  id        String   @id @default(cuid())
  tripId    String
  text      String
  category  String   @default("preparation")
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// === Справка ===
model InfoItem {
  id        String   @id @default(cuid())
  tripId    String
  type      String
  title     String
  content   String
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// === Фраза разговорника ===
model Phrase {
  id        String   @id @default(cuid())
  tripId    String
  category  String
  ru        String
  cn        String
  pinyin    String
  audio     String?
  language  String? // код языка фразы (zh, ja, fr...) — null у записей до миграции
  favorite  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// === Блюдо ===
model FoodItem {
  id          String   @id @default(cuid())
  tripId      String
  name        String
  nameCn      String?
  description String
  city        String
  place       String?
  price       String?
  emoji       String?
  imageUrl    String?
  tried       Boolean  @default(false)
  rating      Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  // JSON-массив userId, проголосовавших «хочу попробовать»
  wantedBy    String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// === Плановый бюджет по категории ===
model BudgetPlan {
  id       String @id @default(cuid())
  tripId   String
  category String
  amount   Float

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, category])
}

// === Обратная связь: баг-репорты, идеи и вопросы из приложения ===
model Feedback {
  id            String    @id @default(cuid())
  userId        String? // автор; переживает удаление аккаунта (SetNull)
  type          String    @default("bug") // bug / idea / question
  message       String
  screenshotUrl String? // /uploads/feedback/*.jpg через единый storage-пайплайн
  status        String    @default("new") // new / in_progress / resolved
  adminNote     String? // внутренняя заметка админа
  // Автоконтекст: страница, откуда отправили, и активная поездка (без FK —
  // поездку могут удалить, репорт остаётся)
  pageUrl       String?
  tripId        String?
  userAgent     String? // заполняет сервер из заголовка, клиенту не доверяем
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resolvedAt    DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}
