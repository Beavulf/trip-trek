// TripTrek — Prisma schema (PostgreSQL, ADR-0002)
// Multi-trip architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Пользователь (глобальный аккаунт) ===
model User {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String
  password   String // bcrypt hash
  // Момент последней смены пароля: JWT с iat раньше него невалиден (см. custom-session) —
  // смена пароля выкидывает другие сессии. null = пароль не меняли, сессии не трогаем.
  passwordChangedAt DateTime?
  emoji      String    @default("👤")
  color      String    @default("#94a3b8")
  avatarUrl  String? // фото пользователя (загруженное)
  plan       String    @default("free") // free / premium
  planExpiry DateTime? // для премиума
  role       String    @default("user") // user / admin
  // Свой ключ ИИ (BYOK): OpenAI-совместимый. Наружу API отдаёт только замаскированный
  // хвост. Приоритет при вызове: свой ключ → админский (AppSettings) → env OPENAI_API_KEY
  aiApiKey   String?
  // Свой адрес провайдера и модель (полный BYOK). База активна ТОЛЬКО вместе со своим
  // ключом: чужой (админский/env) ключ на юзерский адрес не отправляется никогда.
  aiBaseUrl  String?
  aiModel    String?
  // Полный запрет ИИ для юзера (любой источник ключа). Проверяется в runAi — единой
  // точке, чтобы новый ИИ-роут не смог забыть проверку. Управляет админ из /admin/ai.
  aiBlocked  Boolean   @default(false)
  // Момент последнего алерта «порог трат ИИ». Дедуп — раз в UTC-сутки: сравнение
  // «< начала сегодняшних суток» само сбрасывается в полночь, cron не нужен.
  aiAlertedAt DateTime?
  // Обучение (welcome-tour): момент завершения/пропуска. null = не показывали
  // (или сброшено кнопкой «Пройти заново» в профиле) — тур откроется при входе на /
  onboardingCompletedAt DateTime?
  createdAt  DateTime  @default(now())

  memberships   TripMember[]
  photos        Photo[]
  expenses      Expense[]
  journals      JournalEntry[]
  messages      BoardMessage[]
  pushSubs      PushSubscription[]
  feedback      Feedback[]
  adminLogs     AdminLog[]
  tripBans      TripBan[]
  notifications UserNotification[]
  resetTokens   PasswordResetToken[]
  aiUsage       AiUsage[]
}

// === Токены сброса пароля: одноразовые, TTL 60 минут. В БД — только sha256-хеш,
// сырой токен живёт лишь в ссылке из письма. Использованный/просроченный удаляется ===
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // sha256(сырого токена) — утечка БД не даёт рабочих ссылок
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// === Глобальные настройки приложения (singleton-строка id="app") ===
// Общий ключ ИИ и адрес API, заданные админом в /admin → Настройки; используются,
// если у пользователя нет своего ключа. База и модель — настройка сервера целиком
model AppSettings {
  id                  String  @id @default("app")
  aiApiKey            String?
  aiBaseUrl           String? // напр. https://api.z.ai/api/paas/v4 или https://openrouter.ai/api/v1
  aiModel             String? // напр. glm-4.6, gpt-4o-mini
  // Конфиг приложения из админки. null-строки (до записи) трактуются как дефолты
  registrationEnabled Boolean @default(true) // закрыть регистрацию новых аккаунтов
  freeTripLimit       Int     @default(1) // поездок у free-плана
  freeMemberLimit     Int     @default(5) // участников в поездке free-владельца
  // Self-upgrade премиума без оплаты (демо-режим). Дефолт false: аудит 2026-09-12 —
  // самовыдача снимала лимиты тарифа. Включается из админки, когда появится оплата.
  selfUpgradeEnabled  Boolean @default(false)
  // Пороги алертов «нестандартные траты ИИ» на юзера в сутки (UTC). 0 = алерт
  // по этому измерению выключен. Считается по записям AiUsage за текущие сутки.
  aiAlertCallsPerDay  Int     @default(0)
  aiAlertTokensPerDay Int     @default(0)
}

// === Учёт вызовов ИИ: только метаданные, НИКОГДА содержимое промптов/ответов ===
// Пишется из runAi (lib/ai.ts) fire-and-forget: сбой учёта не роняет фичу.
// tripId без FK — статистика юзера переживает удаление поездки (как в Feedback).
model AiUsage {
  id               String   @id @default(cuid())
  userId           String
  tripId           String?
  feature          String // ai-summary / foods-suggest / phrases-ai
  keySource        String // user / admin / env — чей баланс горел
  model            String
  promptTokens     Int      @default(0) // 0, если провайдер не отдал usage
  completionTokens Int      @default(0)
  durationMs       Int      @default(0)
  ok               Boolean  @default(true)
  error            String? // короткий код: timeout / http_401 / network / empty
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt]) // суточные агрегаты юзера: алерты и карточка в админке
  @@index([feature, createdAt]) // графики по фичам
  @@index([createdAt]) // скан окна «14 дней» админ-разделом (таблица растёт монотонно)
}

// === Журнал действий админа: кто и что менял из панели ===
model AdminLog {
  id          String   @id @default(cuid())
  adminId     String? // админ может быть удалён — запись остаётся
  action      String // user.edit / trip.delete / settings.ai / storage.purge / …
  targetType  String // user / trip / feedback / settings / storage
  targetId    String?
  targetLabel String? // человекочитаемо: имя юзера, название поездки…
  meta        Json? // мелкий контекст (суммы, счётчики) — НИКОГДА ключи/пароли
  createdAt   DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType])
}

// === Push подписка (Web Push для уведомлений) ===
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// === Поездка ===
model Trip {
  id          String    @id @default(cuid())
  title       String
  destination String    @default("Unknown")
  startDate   DateTime
  endDate     DateTime?
  totalDays   Int       @default(12)
  totalBudget Float     @default(1100)
  currency    String    @default("USD")
  inviteCode  String    @unique @default(cuid())
  coverColor  String    @default("#f97316")
  coverEmoji  String    @default("🌏")
  status      String    @default("planning") // planning / active / completed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members     TripMember[]
  days        Day[]
  places      Place[]
  photos      Photo[]
  expenses    Expense[]
  journals    JournalEntry[]
  messages     BoardMessage[]
  checklist    ChecklistItem[]
  info         InfoItem[]
  phrases      Phrase[]
  foods        FoodItem[]
  budgetPlans  BudgetPlan[]
  bans         TripBan[]
}

// === Участник поездки (связь User ↔ Trip) ===
model TripMember {
  id          String   @id @default(cuid())
  tripId      String
  userId      String
  role        String   @default("member") // owner / member
  displayName String // имя в рамках поездки
  emoji       String   @default("👤")
  color       String   @default("#94a3b8")
  budget      Float? // персональный бюджет
  joinedAt    DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

// === День поездки ===
model Day {
  id          String   @id @default(cuid())
  tripId      String
  dayNumber   Int
  date        DateTime
  city        String
  cityKey     String
  title       String
  summary     String?
  accentColor String?

  trip     Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  places   Place[]
  photos   Photo[]
  expenses Expense[]
  journals JournalEntry[]

  @@index([tripId])
}

// === Место ===
model Place {
  id          String    @id @default(cuid())
  tripId      String
  name        String
  description String?
  category    String
  lat         Float
  lng         Float
  dayId       String
  timeOfDay   String?
  status      String    @default("planned")
  budget      Float?
  address     String?
  notes       String?
  rating      Int?
  visitedAt   DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  trip   Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day    Day     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@index([tripId])
  @@index([dayId])
}

// === Фото ===
model Photo {
  id         String   @id @default(cuid())
  tripId     String
  url        String
  thumbUrl   String?
  caption    String?
  isFavorite Boolean  @default(false)
  placeId    String?
  dayId      String
  userId     String? // кто загрузил (был participantId)
  lat        Float?
  lng        Float?
  address    String?
  takenAt    DateTime @default(now())
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)
  day   Day    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([dayId])
  @@index([placeId])
}

// === Трата ===
model Expense {
  id               String   @id @default(cuid())
  tripId           String
  amount           Float
  category         String
  description      String
  paidById         String // userId кто заплатил
  dayId            String?
  splitWith        String   @default("") // comma-separated userIds (пусто = личная трата)
  excludeSelf      Boolean  @default(false) // true = плательщик не участвует в делении
  // Исходная сумма и валюта, как пользователь её ввёл (до конвертации в валюту поездки).
  // amount всегда хранится в валюте поездки. originalAmount/originalCurrency хранят то,
  // что ввёл пользователь — чтобы можно было показать «изначально 100 ¥» под конвертированной суммой.
  originalAmount   Float?
  originalCurrency String?
  // settlementKey — детерминированный ключ для идемпотентности переводов (P0 #3).
  // Формат: "settle-{fromId}-{toId}-{сумма-в-центах}-{timestamp}" — уникален на каждый
  // факт перевода, поэтому одна пара может гасить одинаковые по сумме долги многократно.
  // Уникальность — В РАМКАХ поездки (@@unique ниже): глобальный @unique делал ключи
  // разных поездок конфликтующим пространством (аудит 2026-09-12).
  settlementKey    String?
  createdAt        DateTime @default(now())

  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy User @relation(fields: [paidById], references: [id])
  day    Day? @relation(fields: [dayId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([paidById])
  @@unique([tripId, settlementKey])
}

// === Запись дневника ===
model JournalEntry {
  id        String   @id @default(cuid())
  tripId    String
  dayId     String
  userId    String? // был participantId
  mood      String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day  Day   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([dayId])
}

// === Сообщение в чате ===
model BoardMessage {
  id        String    @id @default(cuid())
  tripId    String
  content   String
  userId    String? // был participantId
  pinned    Boolean   @default(false)
  reactions String? // JSON {"👍":["userId",...]}
  editedAt  DateTime?
  replyToId String?
  createdAt DateTime  @default(now())

  trip    Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  replyTo BoardMessage?  @relation("BoardReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies BoardMessage[] @relation("BoardReply")

  @@index([tripId])
}

// === Чек-лист ===
model ChecklistItem {
  id        String   @id @default(cuid())
  tripId    String
  text      String
  category  String   @default("preparation")
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// === Справка ===
model InfoItem {
  id        String   @id @default(cuid())
  tripId    String
  type      String
  title     String
  content   String
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// === Фраза разговорника ===
model Phrase {
  id        String   @id @default(cuid())
  tripId    String
  category  String
  ru        String
  cn        String
  pinyin    String
  audio     String?
  language  String? // код языка фразы (zh, ja, fr...) — null у записей до миграции
  favorite  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// === Блюдо ===
model FoodItem {
  id          String   @id @default(cuid())
  tripId      String
  name        String
  nameCn      String?
  description String
  city        String
  place       String?
  price       String?
  emoji       String?
  imageUrl    String?
  tried       Boolean  @default(false)
  rating      Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  // JSON-массив userId, проголосовавших «хочу попробовать»
  wantedBy    String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// === Плановый бюджет по категории ===
model BudgetPlan {
  id       String @id @default(cuid())
  tripId   String
  category String
  amount   Float

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, category])
}

// === Бан пользователя в конкретной поездке (утёк инвайт-ссылки и т.п.) ===
// Проверяется при джойне; снимается админом или владельцем поездки
model TripBan {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  reason    String?
  createdBy String? // userId того, кто забанил (админ или владелец)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
}

// === Уведомление пользователю (события админ-действий, ответы на отзывы) ===
// В приложении — колокольчик в шапке; при настроенном VAPID дублируется web-push
model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  type      String // premium / password / member_removed / member_banned / member_unbanned / trip_deleted / feedback_reply / admin_message / ownership
  title     String
  body      String?
  url       String? // куда вести по тапу
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// === Обратная связь: баг-репорты, идеи и вопросы из приложения ===
model Feedback {
  id            String    @id @default(cuid())
  userId        String? // автор; переживает удаление аккаунта (SetNull)
  type          String    @default("bug") // bug / idea / question
  message       String
  screenshotUrl String? // /uploads/feedback/*.jpg через единый storage-пайплайн
  status        String    @default("new") // new / in_progress / resolved
  adminNote     String? // внутренняя заметка админа
  adminReply    String? // ответ админа пользователю — придёт ему в уведомления
  repliedAt     DateTime?
  // Автоконтекст: страница, откуда отправили, и активная поездка (без FK —
  // поездку могут удалить, репорт остаётся)
  pageUrl       String?
  tripId        String?
  userAgent     String? // заполняет сервер из заголовка, клиенту не доверяем
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resolvedAt    DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}
