// TripTrek — Prisma schema (PostgreSQL, ADR-0002)
// Multi-trip architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Пользователь (глобальный аккаунт) ===
model User {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String
  password   String // bcrypt hash
  // Момент последней смены пароля: JWT с iat раньше него невалиден (см. custom-session) —
  // смена пароля выкидывает другие сессии. null = пароль не меняли, сессии не трогаем.
  passwordChangedAt DateTime?
  emoji      String    @default("👤")
  color      String    @default("#94a3b8")
  avatarUrl  String? // фото пользователя (загруженное)
  plan       String    @default("free") // free / premium
  planExpiry DateTime? // для премиума
  role       String    @default("user") // user / admin
  // Свой ключ ИИ (BYOK): OpenAI-совместимый. Наружу API отдаёт только замаскированный
  // хвост. Приоритет при вызове: свой ключ → админский (AppSettings) → env OPENAI_API_KEY
  aiApiKey   String?
  // Свой адрес провайдера и модель (полный BYOK). База активна ТОЛЬКО вместе со своим
  // ключом: чужой (админский/env) ключ на юзерский адрес не отправляется никогда.
  aiBaseUrl  String?
  aiModel    String?
  // Полный запрет ИИ для юзера (любой источник ключа). Проверяется в runAi — единой
  // точке, чтобы новый ИИ-роут не смог забыть проверку. Управляет админ из /admin/ai.
  aiBlocked  Boolean   @default(false)
  // Момент последнего алерта «порог трат ИИ». Дедуп — раз в UTC-сутки: сравнение
  // «< начала сегодняшних суток» само сбрасывается в полночь, cron не нужен.
  aiAlertedAt DateTime?
  // Реквизиты для возврата долгов (карта/телефон/что юзер сам решит показать).
  // Видят участники его поездок в экране расчёта — иначе номер карты летит
  // в общий чат (наблюдали в реальной поездке 2026-10). В публичные выгрузки
  // не отдаётся. Юзер осознанно пишет сюда то, чем готов делиться.
  paymentDetails String?
  // Обучение (welcome-tour): момент завершения/пропуска. null = не показывали
  // (или сброшено кнопкой «Пройти заново» в профиле) — тур откроется при входе на /
  onboardingCompletedAt DateTime?
  // Подробный прогресс обучения: по каждому туру (пройден/пропущен/на паузе с шага),
  // «напомнить позже», выключенные подсказки, версия «Что нового». Формат и правила слияния —
  // src/lib/onboarding-state.ts. null = ничего не записано (старые аккаунты)
  onboardingState Json?
  // Какой инвайт-код приложения привёл юзера в бету. SetNull: коды только
  // деактивируются, но если код однажды удалят — юзер не должен сломаться
  inviteCodeId String?
  createdAt  DateTime  @default(now())

  memberships   TripMember[]
  photos        Photo[]
  expenses      Expense[]
  journals      JournalEntry[]
  messages      BoardMessage[]
  pushSubs      PushSubscription[]
  feedback      Feedback[]
  adminLogs     AdminLog[]
  tripBans      TripBan[]
  notifications UserNotification[]
  resetTokens   PasswordResetToken[]
  aiUsage       AiUsage[]
  inviteCode    InviteCode?  @relation("inviteCode", fields: [inviteCodeId], references: [id], onDelete: SetNull)
  splitMemberships SplitMember[]
}

// === Токены сброса пароля: одноразовые, TTL 60 минут. В БД — только sha256-хеш,
// сырой токен живёт лишь в ссылке из письма. Использованный/просроченный удаляется ===
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // sha256(сырого токена) — утечка БД не даёт рабочих ссылок
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// === Инвайт-коды приложения (бета-доступ). Отдельны от инвайт-кодов поездок
// (Trip.inviteCode): этот код проверяется на регистрации АККАУНТА, а не входа в
// поездку. usedCount — авторитетный счётчик: слот занимает атомарный условный
// updateMany в api/auth/register; связь users — только справка «кто пришёл»
model InviteCode {
  id            String    @id @default(cuid())
  code          String    @unique
  note          String? // «тикток-видео», «для Лехи» — только для админа
  maxUses       Int       @default(1)
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  // userId админа, создавшего код, без FK: юзера могут удалить, код остаётся
  createdBy     String

  users User[] @relation("inviteCode")
}

// === Глобальные настройки приложения (singleton-строка id="app") ===
// Общий ключ ИИ и адрес API, заданные админом в /admin → Настройки; используются,
// если у пользователя нет своего ключа. База и модель — настройка сервера целиком
model AppSettings {
  id                  String  @id @default("app")
  aiApiKey            String?
  aiBaseUrl           String? // напр. https://api.z.ai/api/paas/v4 или https://openrouter.ai/api/v1
  aiModel             String? // напр. glm-4.6, gpt-4o-mini
  // Конфиг приложения из админки. null-строки (до записи) трактуются как дефолты
  registrationEnabled Boolean @default(true) // закрыть регистрацию новых аккаунтов
  freeTripLimit       Int     @default(1) // поездок у free-плана
  freeMemberLimit     Int     @default(5) // участников в поездке free-владельца
  // Self-upgrade премиума без оплаты (демо-режим). Дефолт false: аудит 2026-09-12 —
  // самовыдача снимала лимиты тарифа. Включается из админки, когда появится оплата.
  selfUpgradeEnabled  Boolean @default(false)
  // Пороги алертов «нестандартные траты ИИ» на юзера в сутки (UTC). 0 = алерт
  // по этому измерению выключен. Считается по записям AiUsage за текущие сутки.
  aiAlertCallsPerDay  Int     @default(0)
  aiAlertTokensPerDay Int     @default(0)
  // Бета-гейты и витрина лендинга. inviteRequired: при включённой регистрации
  // требовать инвайт-код приложения (api/auth/register)
  inviteRequired  Boolean @default(false)
  demoTripToken   String? // токен публичной поездки для «Живого примера» на лендинге
  contactTelegram String? // «@name» или https-ссылка — футер лендинга и /login
  // Поддержка проекта (блок «Поддержать» внизу профиля): оба поля необязательны, нет ни одного — блока нет
  donationAlertsUrl String? // https-страница DonationAlerts
  webmoneyPurse     String? // WMZ-кошелёк для перевода (Z + 12 цифр)
}

// === Учёт вызовов ИИ: только метаданные, НИКОГДА содержимое промптов/ответов ===
// Пишется из runAi (lib/ai.ts) fire-and-forget: сбой учёта не роняет фичу.
// tripId без FK — статистика юзера переживает удаление поездки (как в Feedback).
model AiUsage {
  id               String   @id @default(cuid())
  userId           String
  tripId           String?
  feature          String // ai-summary / foods-suggest / phrases-ai
  keySource        String // user / admin / env — чей баланс горел
  model            String
  promptTokens     Int      @default(0) // 0, если провайдер не отдал usage
  completionTokens Int      @default(0)
  durationMs       Int      @default(0)
  ok               Boolean  @default(true)
  error            String? // короткий код: timeout / http_401 / network / empty
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt]) // суточные агрегаты юзера: алерты и карточка в админке
  @@index([feature, createdAt]) // графики по фичам
  @@index([createdAt]) // скан окна «14 дней» админ-разделом (таблица растёт монотонно)
}

// === Журнал действий админа: кто и что менял из панели ===
model AdminLog {
  id          String   @id @default(cuid())
  adminId     String? // админ может быть удалён — запись остаётся
  action      String // user.edit / trip.delete / settings.ai / storage.purge / …
  targetType  String // user / trip / feedback / settings / storage
  targetId    String?
  targetLabel String? // человекочитаемо: имя юзера, название поездки…
  meta        Json? // мелкий контекст (суммы, счётчики) — НИКОГДА ключи/пароли
  createdAt   DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType])
}

// === Push подписка (Web Push для уведомлений) ===
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// === Поездка ===
model Trip {
  id          String    @id @default(cuid())
  title       String
  destination String    @default("Unknown")
  startDate   DateTime
  endDate     DateTime?
  totalDays   Int       @default(12)
  totalBudget Float     @default(1100)
  currency    String    @default("USD")
  inviteCode  String    @unique @default(cuid())
  // Кто может приглашать участников: true — все участники, false — только владелец
  // (тогда GET /api/trip прячет inviteCode от не-владельцев, join остаётся по коду)
  allowMemberInvites Boolean @default(true)
  coverColor  String    @default("#f97316")
  coverEmoji  String    @default("🌏")
  status      String    @default("planning") // planning / active / completed
  // Публичная read-only страница для родных (галерея+маршрут+карта, без денег
  // и чата): /p/<shareToken>. Токен только при shareEnabled; rotate — замена
  // токена мгновенно инвалидирует старую ссылку (утекла — перегенерил)
  shareEnabled Boolean  @default(false)
  shareToken   String?  @unique
  // Публичная страница: можно ли гостям скачать ZIP всех фото (тумблер в
  // карточке «Поделиться») и счётчик гостевых сердечек /p/<token>/heart
  shareAllowDownload Boolean @default(true)
  shareHearts        Int     @default(0)
  // Срок действия публичной ссылки: после этого момента страница, порции фото, ZIP и
  // сердечко закрыты, токен остаётся (продлил — тот же адрес). null — бессрочно
  shareExpiresAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members     TripMember[]
  days        Day[]
  places      Place[]
  photos      Photo[]
  expenses    Expense[]
  journals    JournalEntry[]
  messages     BoardMessage[]
  checklist    ChecklistItem[]
  info         InfoItem[]
  phrases      Phrase[]
  foods        FoodItem[]
  budgetPlans  BudgetPlan[]
  bans         TripBan[]
  lodgings     Lodging[]
}

// === Участник поездки (связь User ↔ Trip) ===
model TripMember {
  id          String   @id @default(cuid())
  tripId      String
  userId      String
  role        String   @default("member") // owner / member
  displayName String // имя в рамках поездки
  emoji       String   @default("👤")
  color       String   @default("#94a3b8")
  budget      Float? // персональный бюджет
  joinedAt    DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

// === День поездки ===
model Day {
  id          String   @id @default(cuid())
  tripId      String
  dayNumber   Int
  date        DateTime
  city        String
  cityKey     String
  title       String
  summary     String?
  accentColor String?

  trip     Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  places   Place[]
  photos   Photo[]
  expenses Expense[]
  journals JournalEntry[]

  @@index([tripId])
}

// === Место ===
model Place {
  id          String    @id @default(cuid())
  tripId      String
  name        String
  description String?
  category    String
  lat         Float
  lng         Float
  dayId       String
  timeOfDay   String?
  status      String    @default("planned")
  budget      Float?
  address     String?
  notes       String?
  rating      Int?
  visitedAt   DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  trip   Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day    Day     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@index([tripId])
  @@index([dayId])
}

// === Фото ===
model Photo {
  id         String   @id @default(cuid())
  tripId     String
  url        String
  thumbUrl   String?
  caption    String?
  isFavorite Boolean  @default(false)
  placeId    String?
  dayId      String
  userId     String? // кто загрузил (был participantId)
  lat        Float?
  lng        Float?
  address    String?
  takenAt    DateTime @default(now())
  width      Int?
  height     Int?
  // Отпечаток содержимого (sha256 оригинального файла) — дедуп: повторная
  // загрузка того же кадра отклоняется, батч заранее помечает дубли
  contentHash String?
  // Скрыто от гостей публичной страницы /p/<token> (билеты, документы, личное):
  // в самой поездке фото видно как обычно, наружу — ни на странице, ни в ZIP
  hiddenFromPublic Boolean @default(false)
  createdAt  DateTime @default(now())

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)
  day   Day    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([dayId])
  @@index([placeId])
  @@index([tripId, contentHash])
}

// === Трата ===
model Expense {
  id               String   @id @default(cuid())
  tripId           String
  amount           Float
  category         String
  description      String
  paidById         String // userId кто заплатил
  dayId            String?
  splitWith        String   @default("") // comma-separated userIds (пусто = личная трата)
  excludeSelf      Boolean  @default(false) // true = плательщик не участвует в делении
  // Исходная сумма и валюта, как пользователь её ввёл (до конвертации в валюту поездки).
  // amount всегда хранится в валюте поездки. originalAmount/originalCurrency хранят то,
  // что ввёл пользователь — чтобы можно было показать «изначально 100 ¥» под конвертированной суммой.
  originalAmount   Float?
  originalCurrency String?
  // settlementKey — детерминированный ключ для идемпотентности переводов (P0 #3).
  // Формат: "settle-{fromId}-{toId}-{сумма-в-центах}-{timestamp}" — уникален на каждый
  // факт перевода, поэтому одна пара может гасить одинаковые по сумме долги многократно.
  // Уникальность — В РАМКАХ поездки (@@unique ниже): глобальный @unique делал ключи
  // разных поездок конфликтующим пространством (аудит 2026-09-12).
  settlementKey    String?
  createdAt        DateTime @default(now())

  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy User @relation(fields: [paidById], references: [id])
  day    Day? @relation(fields: [dayId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([paidById])
  @@unique([tripId, settlementKey])
}

// === Запись дневника ===
model JournalEntry {
  id        String   @id @default(cuid())
  tripId    String
  dayId     String
  userId    String? // был participantId
  mood      String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day  Day   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([dayId])
}

// === Сообщение в чате ===
model BoardMessage {
  id        String    @id @default(cuid())
  tripId    String
  content   String
  userId    String? // был participantId
  pinned    Boolean   @default(false)
  reactions String? // JSON {"👍":["userId",...]}
  editedAt  DateTime?
  replyToId String?
  createdAt DateTime  @default(now())

  trip    Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  replyTo BoardMessage?  @relation("BoardReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies BoardMessage[] @relation("BoardReply")

  @@index([tripId])
}

// === Чек-лист ===
model ChecklistItem {
  id        String   @id @default(cuid())
  tripId    String
  text      String
  category  String   @default("preparation")
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// === Проживание ===
// Отдельная сущность, а не Place категории hotel: маршрут описывает «что делаем»,
// а жильё — «где ночуем» (заезд/выезд, бронь, телефон, цена). Даты — календарные
// (без часового пояса): храним полдень UTC, чтобы календарный день не прыгал
// в зависимости от пояса сервера и клиента (см. src/lib/lodging.ts).
model Lodging {
  id           String   @id @default(cuid())
  tripId       String
  name         String
  nameLocal    String? // название на местном языке — для «Показать таксисту»
  city         String?
  address      String? // адрес на местном языке, как его читает водитель
  lat          Float?
  lng          Float?
  checkIn      DateTime // день заезда
  checkOut     DateTime // день выезда: ночь этого дня уже не здесь
  checkInTime  String? // "14:00"
  checkOutTime String? // "12:00"
  bookingRef   String?
  bookingUrl   String?
  phone        String?
  price        Float? // за всё проживание, в валюте поездки
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// === Справка ===
model InfoItem {
  id        String   @id @default(cuid())
  tripId    String
  type      String
  title     String
  content   String
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// === Фраза разговорника ===
model Phrase {
  id        String   @id @default(cuid())
  tripId    String
  category  String
  ru        String
  cn        String
  pinyin    String
  audio     String?
  language  String? // код языка фразы (zh, ja, fr...) — null у записей до миграции
  favorite  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// === Блюдо ===
model FoodItem {
  id          String   @id @default(cuid())
  tripId      String
  name        String
  nameCn      String?
  description String
  city        String
  place       String?
  price       String?
  emoji       String?
  imageUrl    String?
  tried       Boolean  @default(false)
  rating      Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  // JSON-массив userId, проголосовавших «хочу попробовать»
  wantedBy    String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// === Плановый бюджет по категории ===
model BudgetPlan {
  id       String @id @default(cuid())
  tripId   String
  category String
  amount   Float

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, category])
}

// === Бан пользователя в конкретной поездке (утёк инвайт-ссылки и т.п.) ===
// Проверяется при джойне; снимается админом или владельцем поездки
model TripBan {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  reason    String?
  createdBy String? // userId того, кто забанил (админ или владелец)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
}

// === Уведомление пользователю (события админ-действий, ответы на отзывы) ===
// В приложении — колокольчик в шапке; при настроенном VAPID дублируется web-push
model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  type      String // premium / password / member_removed / member_banned / member_unbanned / trip_deleted / feedback_reply / admin_message / ownership
  title     String
  body      String?
  url       String? // куда вести по тапу
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// === Обратная связь: баг-репорты, идеи, вопросы, жалобы и отзывы из приложения ===
// Обращение = первое сообщение (message) + переписка в FeedbackMessage.
// Статус отвечает на вопрос «чья очередь»: new — ждёт админа (новое или юзер дописал),
// in_progress — админ взял в работу/ответил, resolved — закрыто (юзер может дописать — вернётся в new).
model Feedback {
  id             String    @id @default(cuid())
  userId         String? // автор; null — гость (письмо с /login) или аккаунт удалён (SetNull)
  type           String    @default("bug") // bug / idea / question / complaint / review
  message        String
  screenshotUrl  String? // /uploads/feedback/*.jpg через единый storage-пайплайн
  status         String    @default("new") // new / in_progress / resolved
  adminNote      String? // внутренняя заметка админа
  // УСТАРЕЛО: до переписки ответ админа лежал здесь. Миграция перенесла его в FeedbackMessage;
  // колонки оставлены, чтобы откат на прошлую сборку не падал. Код их не читает и не пишет
  adminReply     String?
  repliedAt      DateTime?
  // Автоконтекст: вкладка приложения, откуда отправили, и активная поездка (без FK —
  // поездку могут удалить, репорт остаётся)
  pageUrl        String?
  screen         String? // где был юзер: id вкладки SPA (trip-store.TripTab) или путь без id; путь у главного экрана всегда «/»
  tripId         String?
  userAgent      String? // заполняет сервер из заголовка, клиенту не доверяем
  viewport       String? // «390x844» (+ «pwa»), для багов вёрстки
  appVersion     String? // версия сборки, которую видел юзер (устаревший PWA-кэш — частая причина багов)
  contactEmail   String? // только у гостей: куда писать ответ
  lastActivityAt DateTime  @default(now()) // последнее сообщение любой стороны — сортировка очереди
  userSeenAt     DateTime? // когда автор последний раз открыл обращение: ответ новее — «непрочитано»
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?

  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages FeedbackMessage[]

  @@index([status, lastActivityAt])
  @@index([userId])
}

// Реплики переписки после первого сообщения обращения
model FeedbackMessage {
  id         String   @id @default(cuid())
  feedbackId String
  author     String // user / admin
  authorId   String? // кто писал; без FK — аккаунт могут удалить, реплика остаётся
  body       String
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId, createdAt])
}

// ============================================================================
// «Сочтёмся» — повседневные общие траты друзей (ADR-0009).
// Отдельно от поездок: свои группы, участники, траты. Деньги — целые центы
// в валюте группы; расчёт ссылается на SplitMember.id, а не на User.id.
// ============================================================================

// === Группа: квартира, компания, пара ===
model SplitGroup {
  id                 String   @id @default(cuid())
  name               String
  emoji              String   @default("🏠")
  color              String   @default("#10b981")
  // Валюта группы (ISO-код): все суммы группы хранятся в ней, в центах; пересчёта по курсу нет.
  // Меняется только пока в группе нет трат/переводов
  currency           String   @default("BYN")
  // Короткий код для ссылки и ручного ввода; генерирует приложение (src/lib/split/invite.ts)
  inviteCode         String   @unique
  // Кто может звать новых: true — все участники, false — только владелец
  allowMemberInvites Boolean  @default(true)
  // Автонапоминание должникам: через сколько дней существующего долга напомнить (и повторять). null — выключено (ADR-0010)
  remindAfterDays    Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members    SplitMember[]
  expenses   SplitExpense[]
  payments   SplitPayment[]
  recurrings SplitRecurring[]
  activity   SplitActivity[]
  reminders  SplitReminder[]
}

// === Участник группы. userId = null — участник без аккаунта: друг потом заходит
// по коду группы и выбирает «Это я». Строка не удаляется при выходе (status) —
// история и долги остаются на месте ===
model SplitMember {
  id          String    @id @default(cuid())
  groupId     String
  userId      String?
  role        String    @default("member") // owner / member
  status      String    @default("active") // active / left / removed (removed не может вернуться по коду)
  displayName String
  emoji       String    @default("👤")
  color       String    @default("#94a3b8")
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  group SplitGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  paidExpenses    SplitExpense[] @relation("SplitExpensePayer")
  createdExpenses SplitExpense[] @relation("SplitExpenseAuthor")
  shares          SplitShare[]
  paymentsSent    SplitPayment[] @relation("SplitPaymentFrom")
  paymentsGot     SplitPayment[] @relation("SplitPaymentTo")
  paymentsMade    SplitPayment[] @relation("SplitPaymentAuthor")

  // NULL в userId уникальность не нарушают: безаккаунтных в группе может быть несколько
  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, status])
}

// === Трата. Доли каждого — в SplitShare, Σ долей = amountCents ===
model SplitExpense {
  id              String   @id @default(cuid())
  groupId         String
  // Сумма в валюте ГРУППЫ (в ней считаются долги и итоги). Если трату ввели в другой валюте — это пересчитанная
  // сумма (курс на момент ввода или вручную поправленная), а то, что ввели, — в originalAmountCents/originalCurrency
  amountCents     Int
  originalAmountCents Int?
  originalCurrency    String?
  description     String
  category        String
  paidById        String // SplitMember.id
  // Календарная дата траты (без часового пояса): «вчерашний чек» вносится задним числом
  spentOn         DateTime @db.Date
  note            String?
  // Как делили: equal / exact / shares / percent — чтобы открыть форму на правку в том же виде
  splitMode       String   @default("equal")
  createdById     String // SplitMember.id
  // Трата создана шаблоном; (recurringId, recurringPeriod) уникален — ленивая материализация идемпотентна
  recurringId     String?
  recurringPeriod String? // "2026-10"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group     SplitGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy    SplitMember     @relation("SplitExpensePayer", fields: [paidById], references: [id], onDelete: NoAction)
  createdBy SplitMember     @relation("SplitExpenseAuthor", fields: [createdById], references: [id], onDelete: NoAction)
  recurring SplitRecurring? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  shares    SplitShare[]
  payments  SplitPayment[]

  @@unique([recurringId, recurringPeriod])
  @@index([groupId, spentOn])
  @@index([paidById])
}

// === Доля участника в трате (в центах). weight — вес/процент для режимов shares/percent
// (проценты в сотых долях: 33,33% = 3333), чтобы форма правки восстанавливалась точно ===
model SplitShare {
  id        String @id @default(cuid())
  expenseId String
  memberId  String
  cents     Int
  weight    Int?

  expense SplitExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  SplitMember  @relation(fields: [memberId], references: [id], onDelete: NoAction)

  @@unique([expenseId, memberId])
  @@index([memberId])
}

// === Перевод «отдал деньги»: гасит долг пары. Отдельная сущность, не трата ===
model SplitPayment {
  id          String   @id @default(cuid())
  groupId     String
  fromId      String // кто отдал (SplitMember.id)
  toId        String // кому
  amountCents Int
  paidOn      DateTime @db.Date
  note        String?
  createdById String // кто записал: любая сторона пары
  // Перевод «за конкретную трату»: помечает долю в ней оплаченной (на балансе пары это обычный перевод).
  // Трату удалили — перевод остаётся (деньги были отданы), связь обнуляется
  expenseId   String?
  // Ключ идемпотентности от клиента: двойной тап / повтор запроса не создаёт второй перевод
  clientKey   String?
  createdAt   DateTime @default(now())

  group     SplitGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from      SplitMember @relation("SplitPaymentFrom", fields: [fromId], references: [id], onDelete: NoAction)
  to        SplitMember @relation("SplitPaymentTo", fields: [toId], references: [id], onDelete: NoAction)
  createdBy SplitMember @relation("SplitPaymentAuthor", fields: [createdById], references: [id], onDelete: NoAction)
  expense   SplitExpense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@unique([groupId, clientKey])
  @@index([groupId, paidOn])
  @@index([expenseId])
}

// === Повторяющаяся трата (аренда, интернет, подписка): создаётся лениво при чтении группы ===
model SplitRecurring {
  id          String    @id @default(cuid())
  groupId     String
  description String
  category    String
  // Сумма в валюте группы (последний пересчёт — для подписи). Если задана originalCurrency, каждый период пересчитывается
  // из originalAmountCents по курсу на момент создания траты (аренда в долларах — в разные месяцы разная сумма в местной валюте)
  amountCents Int
  originalAmountCents Int?
  originalCurrency    String?
  paidById    String // SplitMember.id
  splitMode   String    @default("equal")
  // Деление: [{ memberId, value }], value — вес/процент (в сотых)/центы по режиму, null для equal
  template    Json
  dayOfMonth  Int // 1..31; в коротком месяце — последний день
  startsOn    DateTime  @db.Date
  endsOn      DateTime? @db.Date
  active      Boolean   @default(true)
  // Периоды ("2026-10"), которые пользователь удалил вручную: ленивая материализация их не воскрешает
  skippedPeriods String[] @default([])
  createdById String // SplitMember.id
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  group    SplitGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expenses SplitExpense[]

  @@index([groupId, active])
}

// === Журнал группы: кто что сделал и что изменил (структурированно, текст строит клиент) ===
model SplitActivity {
  id        String   @id @default(cuid())
  groupId   String
  actorId   String? // SplitMember.id; null — система (повторяющаяся трата)
  type      String // expense.created / expense.updated / expense.deleted / payment.created / ...
  data      Json
  createdAt DateTime @default(now())

  group SplitGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

// === Напоминание должнику «верни долг» (ADR-0010): и история для подписи «напомнили 3 ч назад», и кулдаун
// (ручное — раз в 12 ч на пару; авто — раз в remindAfterDays). Участников не ссылаем FK: запись — след события,
// удаление группы чистит её явно (deleteSplitGroup) ===
model SplitReminder {
  id          String   @id @default(cuid())
  groupId     String
  fromId      String // должник (SplitMember.id)
  toId        String // кредитор
  amountCents Int // долг на момент напоминания
  kind        String // manual / auto
  createdAt   DateTime @default(now())

  group SplitGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, fromId, toId, createdAt])
}
